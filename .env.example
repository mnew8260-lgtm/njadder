# ════════════════════════════════════════════════════════════
# NJADDER PRO v7.0 — Environment Variables
# ════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Next.js automatically loads .env for both `next dev` and `next start`.
# NEVER commit .env to git (it's already in .gitignore).

# ─── Database (Neon Postgres — free forever) ──────────────
# Get free Neon DB: https://neon.tech
#   1. Sign up → Create project
#   2. Copy "Connection string" (with -pooler suffix for production)
#   3. Paste below
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# ─── Telegram API credentials ─────────────────────────────
# Get from: https://my.telegram.org → API development tools
# These are used as defaults when user doesn't provide their own.
# WARNING: leaving the fallback values may cause Telegram to flood-ban
# your shared API. Get your own from my.telegram.org.
TELEGRAM_API_ID="35923747"
TELEGRAM_API_HASH="6de1cf34ed1e68d94615ba7b45391dde"

# ─── JWT secret (CRITICAL — do not leave default) ─────────
# Used to sign session cookies. If leaked, all sessions can be forged.
# Generate with: openssl rand -hex 48
# Default fallback "njadder-secret-2026" is INSECURE for production.
JWT_SECRET="replace-with-96-char-hex-string-from-openssl-rand"

# ─── Node environment ─────────────────────────────────────
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"

# ─── Official Channels & Support (shown in UI) ────────────
DEV_CHANNEL_1="@njadder_pro"
DEV_CHANNEL_2="@NMDDER_ch"
SUPPORT_GROUP="@NMDDER_SUPPORT"
