# ════════════════════════════════════════════════════════════
# NJADDER v6.2 — Environment Variables
# ════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Next.js automatically loads .env.local for both `next dev` and `next start`.
# NEVER commit .env.local to git (it's already in .gitignore).

# ─── Database (Neon Postgres — free forever) ──────────────
# Get free Neon DB: https://neon.tech
#   1. Sign up → Create project
#   2. Copy "Connection string" (with -pooler suffix for production)
#   3. Paste below
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# ─── Telegram API (default fallback) ──────────────────────
# Get from: https://my.telegram.org → API development tools
TELEGRAM_API_ID="35923747"
TELEGRAM_API_HASH="6de1cf34ed1e68d94615ba7b45391dde"

# ─── Auth (JWT-like session secret) ───────────────────────
# Generate with: openssl rand -hex 48
NEXTAUTH_SECRET="replace-with-96-char-hex-string"

# ─── Owner Account (first-time setup) ─────────────────────
OWNER_USERNAME="admin"
OWNER_PASSWORD="ChangeMe-Strong-2026!"
OWNER_EMAIL="admin@njadder.com"

# ─── Optional: Public URL ─────────────────────────────────
# NEXTAUTH_URL="https://njadder-app.tech"
